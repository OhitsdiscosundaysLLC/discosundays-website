{
  "name": "disco-sundays-website",
  "version": "1.0.0",
  "private": true,
  "description": "Disco Sundays public website \u2014 1:1 migration of discosundays.com from Shopify to Next.js on Vercel",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-data.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content:sync": "node scripts/crawl.mjs && node scripts/transform.mjs",
    "build:local": "next build",
    "test:functional": "node scripts/functional-test.mjs",
    "test:visual": "node scripts/visual-compare.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "cheerio": "^1.1.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
