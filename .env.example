# Public URL of this site (used for canonical tags, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://discosundays.com

# Shopify store that keeps handling checkout and orders.
# Cart permalinks are sent here: https://<domain>/cart/<variant>:<qty>
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=disco-sundays.myshopify.com

# Contact / EPK / remote-mixing form delivery (optional until configured).
# Without these the form API answers 503 and the form shows an error — it never pretends to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
